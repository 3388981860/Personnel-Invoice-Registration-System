# 强制行尾，避免再出现"Windows 批处理写成 LF 打不开"这类问题
# .bat / .cmd 必须是 CRLF，cmd.exe 才不会把命令拆错
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# Linux 脚本必须是 LF，否则 bash 会报 $'\r': command not found
*.sh      text eol=lf

# 说明文档按 Windows 习惯（记事本打开不会连成一行）
*.txt     text eol=crlf
*.md      text eol=lf

# 模型词典是训练数据，行尾不能动
运行库/**        -text
程序/审核/模型/** -text

# 二进制文件不做任何换行转换
*.png     binary
*.pdf     binary
*.onnx    binary
*.db      binary
*.xlsx    binary
*.pyc     binary
