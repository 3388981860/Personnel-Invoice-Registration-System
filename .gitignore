# ==========================================================================
#  .gitignore —— 哪些文件不进版本库
#  原则：代码、配置、文档进库；真实发票与台账数据只留在本机。
#  注意：本文件只对"以后"生效。已经被提交过的文件要先取消跟踪：
#        git rm -r --cached 发票存档 数据
# ==========================================================================

# ---------------- 业务数据（含真实发票信息，禁止上传）----------------
# 发票原件：里面有购销方名称、税号、金额、出行人、银行账号
发票存档/

# 台账数据库 / Excel 台账 / 每日备份 / 删除回收站
数据/*.db
数据/*.db-journal
数据/*.db-wal
数据/*.db-shm
数据/*.xlsx
数据/备份/
数据/已删除/

# 查验结果截图（同样是发票原件的画面）
数据/查验截图/

# 上传暂存、验证码取样等临时文件
数据/临时/

# 自检报告（每台机器各不相同，没必要进库）
自检报告.txt

# ---------------- 运行时产物 ----------------
__pycache__/
*.pyc
*.pyo
*.log
logs/

# ---------------- 编辑器 / 系统 ----------------
.vscode/
.idea/
Thumbs.db
desktop.ini
*.swp

# ==========================================================================
#  仍会进版本库的（故意不忽略）：
#    程序/、网页/、运行库/、启动.bat、自检.py、操作说明.txt
#    数据/查验配置.json   ← 查验参数属于配置，不是数据，改了需要可追溯
# ==========================================================================
